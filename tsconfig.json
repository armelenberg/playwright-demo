{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",
    "types": ["node", "@playwright/test"],
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "lib": ["DOM", "ES2022"],
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
  },
  "include": ["playwright.config.ts", "src/**/*.ts", "tests/**/*.ts"],
}
